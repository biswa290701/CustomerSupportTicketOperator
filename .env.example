# Copy this file to `.env` and adjust if needed.
# The application runs with the defaults below - no LLM / API key is required.

# Interface the dashboard binds to
APP_HOST=127.0.0.1

# Port the dashboard listens on
APP_PORT=8000

# SQLite database file (relative paths are resolved from the project root).
# Delete this file to reset all ticket data.
TICKET_DB_PATH=data/tickets.db
